# syntax=docker/dockerfile:1.4

FROM node:24-bookworm-slim AS web-builder

ARG JELLYFIN_VERSION=12.0.0-AutoFilm
WORKDIR /web
COPY --from=autofilm_web /package.json /package-lock.json /.npmrc ./
RUN --mount=type=cache,id=autofilm-jellyfin-web-npm,target=/root/.npm \
    npm ci \
        --no-audit \
        --no-fund \
        --fetch-retries=5 \
        --fetch-retry-mintimeout=20000 \
        --fetch-retry-maxtimeout=120000
COPY --from=autofilm_web / /web/
RUN JELLYFIN_VERSION="${JELLYFIN_VERSION}" npm run build:production

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS builder

ARG TARGET_RUNTIME=linux-x64
WORKDIR /src
COPY . .
RUN --mount=type=cache,id=autofilm-jellyfin-nuget,target=/root/.nuget/packages \
    dotnet restore Jellyfin.Server/Jellyfin.Server.csproj \
        --runtime "${TARGET_RUNTIME}" \
        --disable-parallel
RUN --mount=type=cache,id=autofilm-jellyfin-nuget,target=/root/.nuget/packages \
    dotnet publish Jellyfin.Server/Jellyfin.Server.csproj \
        --configuration Release \
        --runtime "${TARGET_RUNTIME}" \
        --self-contained true \
        --no-restore \
        --output /publish \
        /p:DebugSymbols=false \
        /p:DebugType=None

FROM nyanmisaka/jellyfin:latest

COPY --from=builder /publish/ /autofilm-jellyfin/
COPY --from=web-builder /web/dist/ /autofilm-jellyfin-web/

ENV JELLYFIN_DATA_DIR=/config \
    JELLYFIN_CACHE_DIR=/cache \
    JELLYFIN_CONFIG_DIR=/config/config \
    JELLYFIN_LOG_DIR=/config/log \
    JELLYFIN_WEB_DIR=/autofilm-jellyfin-web

EXPOSE 8096
ENTRYPOINT ["/autofilm-jellyfin/jellyfin"]
